import RequestProject.BSCert.RankinK
open BSCert BSCert.FX BSCert.Rankin
def CH : ℕ := 1000
def NCH : ℕ := 100
def main : IO Unit := do
  let mut C : ℤ := 0
  let mut out : Array ℤ := #[0]
  for n in [0:100001] do
    C := C + termHiK 69 100 n
    if (n + 1) % CH = 0 ∨ n = 100000 then out := out.push C
  -- constants module
  let consts := String.intercalate ", " (out.toList.map toString)
  let mut s := s!"module\n\npublic import RequestProject.BSCert.RankinK\n\n/-! Running sums `∑_(n < 1000 k) termHiK 69 100 n` (`k ≤ 100`) and the sum up to `10⁵`\ninclusive, for the kernel-checked head sum of `R(0.69)`. Generated by `genrk.lean`. -/\n\n@[expose] public section\n\nnamespace BSCert.Rankin\n\n/-- The running sums. -/\ndef rkC (k : ℕ) : ℤ := [{consts}].getD k 0\n\nend BSCert.Rankin\n"
  IO.FS.writeFile "RequestProject/BSCert/RankinKC.lean" s
  for f in [0:5] do
    let mut t := s!"module\n\npublic import RequestProject.BSCert.RankinKC\n\n/-! Kernel-checked chunks {20*f}–{20*f+19} of the head sum of `R(0.69)`. Generated by `genrk.lean`. -/\n\n@[expose] public section\n\nnamespace BSCert.Rankin\n\nopen BSCert.FiniteN\n\n"
    for k in [20*f:20*f+20] do
      t := t ++ s!"lemma rk_chunk{k} : K.sumUp (termHiK 69 100) 1000 (1000 * {k}) (rkC {k}) = rkC {k+1} := by\n  decide +kernel\n\n"
    t := t ++ "end BSCert.Rankin\n"
    IO.FS.writeFile s!"RequestProject/BSCert/RankinKChunks{f}.lean" t
  IO.println s!"{out.size} constants"
