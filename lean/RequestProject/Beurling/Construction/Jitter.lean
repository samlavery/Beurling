module

public import Mathlib

/-!
# The probability space of the construction (Section 3.4)

The only randomness in the construction is the jitter: at each slot `j` an offset `U_j`, uniform
on `[0, 1]`, and the `U_j` are independent. Here:

* `jitterMeasure` is the product of countably many copies of the uniform law on `[0, 1]`, on
  `Ω = ℕ → ℝ` (`U_j(ω) = ω j`); it is a probability measure;
* the `U_j` are independent, each uniform on `[0, 1]`, and a.s. all lie in `[0, 1]`;
* `jitterFiltration t` is the σ-field of the offsets at slots `≤ t` (`F_t` of §3.4); `U` is
  adapted, and `U_{t+1}` is independent of `F_t`;
* `landing s H U = s + H (U - 1/2)` is the landing point of a prime decided at slot start `s` with
  width `H`; it lies in the box `[s - H/2, s + H/2]`, and its law is uniform on that box
  ("box-centred jitter").
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set

namespace Construction

/-- The uniform law on `[0, 1]`. -/
noncomputable def unif01 : Measure ℝ := volume.restrict (Icc (0 : ℝ) 1)

instance : IsProbabilityMeasure unif01 := ⟨by simp [unif01]⟩

/-- The sample space of the jitters: `ω j = U_j`. -/
abbrev JitterΩ := ℕ → ℝ

/-- The law of the jitters: i.i.d. uniform on `[0, 1]`. -/
noncomputable def jitterMeasure : Measure JitterΩ := Measure.infinitePi (fun _ : ℕ => unif01)

instance : IsProbabilityMeasure jitterMeasure := by
  unfold jitterMeasure; infer_instance

/-- The jitter `U_j`. -/
def jitter (j : ℕ) (ω : JitterΩ) : ℝ := ω j

lemma measurable_jitter (j : ℕ) : Measurable (jitter j) := measurable_pi_apply j

/-- The jitters are independent. -/
theorem jitter_iIndepFun : iIndepFun jitter jitterMeasure :=
  iIndepFun_infinitePi (P := fun _ : ℕ => unif01) (X := fun _ => id) (fun _ => measurable_id)

/-- Each jitter is uniform on `[0, 1]`. -/
theorem jitter_map (j : ℕ) : jitterMeasure.map (jitter j) = unif01 :=
  (measurePreserving_eval_infinitePi (fun _ : ℕ => unif01) j).map_eq

/-- Almost surely every jitter lies in `[0, 1]`. -/
theorem ae_jitter_mem : ∀ᵐ ω ∂jitterMeasure, ∀ j, ω j ∈ Icc (0 : ℝ) 1 := by
  rw [ae_all_iff]
  intro j
  have h : ∀ᵐ u ∂unif01, u ∈ Icc (0 : ℝ) 1 := ae_restrict_mem measurableSet_Icc
  rw [← jitter_map j] at h
  exact ae_of_ae_map (measurable_jitter j).aemeasurable h

/-- The filtration `F_t`: the σ-field of the jitters at slots `≤ t`. -/
noncomputable def jitterFiltration : Filtration ℕ (MeasurableSpace.pi : MeasurableSpace JitterΩ) :=
  Filtration.piLE

/-- `F_t` is generated by the jitters `U_j`, `j ≤ t`. -/
lemma jitterFiltration_eq (t : ℕ) :
    (jitterFiltration t : MeasurableSpace JitterΩ) =
      ⨆ j ∈ Iic t, MeasurableSpace.comap (jitter j) inferInstance := by
  show MeasurableSpace.comap (Preorder.restrictLe t) MeasurableSpace.pi = _
  rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp_rw [MeasurableSpace.comap_comp]
  rw [iSup_subtype']
  rfl

/-- `U_t` is `F_t`-measurable. -/
lemma jitter_measurable_filtration (t : ℕ) :
    Measurable[jitterFiltration t] (jitter t) := by
  rw [measurable_iff_comap_le, jitterFiltration_eq]
  exact le_iSup₂ (f := fun j (_ : j ∈ Iic t) => MeasurableSpace.comap (jitter j) inferInstance)
    t self_mem_Iic

/-- `U_{t+1}` is independent of the past `F_t`. -/
theorem jitter_indep_past (t : ℕ) :
    Indep (MeasurableSpace.comap (jitter (t + 1)) inferInstance) (jitterFiltration t)
      jitterMeasure := by
  have h := indep_iSup_of_disjoint (m := fun j => MeasurableSpace.comap (jitter j) inferInstance)
    (fun j => (measurable_jitter j).comap_le) jitter_iIndepFun.iIndep
    (S := {t + 1}) (T := Iic t) (by simp)
  rw [jitterFiltration_eq]
  simpa using h

/-- The landing point `s + H (U - 1/2)` of a prime decided at slot start `s`, width `H`. -/
noncomputable def landing (s H U : ℝ) : ℝ := s + H * (U - 1 / 2)

/-- The landing point lies in the box `[s - H/2, s + H/2]`. -/
lemma landing_mem_box {s H U : ℝ} (hH : 0 ≤ H) (hU : U ∈ Icc (0 : ℝ) 1) :
    landing s H U ∈ Icc (s - H / 2) (s + H / 2) := by
  unfold landing
  constructor <;> nlinarith [hU.1, hU.2]

/-- **Box-centred landing law**: for `H > 0` the landing point of a uniform jitter is uniform on
`[s - H/2, s + H/2]`: `P(landing ∈ B) = |B ∩ box| / H`. -/
theorem landing_law {s H : ℝ} (hH : 0 < H) (B : Set ℝ) :
    unif01 (landing s H ⁻¹' B) = volume (B ∩ Icc (s - H / 2) (s + H / 2)) / ENNReal.ofReal H := by
  unfold unif01 landing
  rw [Measure.restrict_apply' measurableSet_Icc]
  have e : (fun U => s + H * (U - 1 / 2)) ⁻¹' B ∩ Icc 0 1 =
      (fun U => H * U) ⁻¹' ((fun v => v + (s - H / 2)) ⁻¹' (B ∩ Icc (s - H / 2) (s + H / 2))) := by
    ext U
    simp only [mem_inter_iff, mem_preimage, mem_Icc]
    constructor
    · rintro ⟨h1, h2, h3⟩
      refine ⟨by convert h1 using 1; ring, by nlinarith, by nlinarith⟩
    · rintro ⟨h1, h2, h3⟩
      refine ⟨by convert h1 using 1; ring, ?_, ?_⟩
      · by_contra h; push_neg at h; nlinarith
      · by_contra h; push_neg at h; nlinarith
  rw [e, Real.volume_preimage_mul_left hH.ne', measure_preimage_add_right]
  rw [abs_of_pos (inv_pos.mpr hH), ENNReal.div_eq_inv_mul, ENNReal.ofReal_inv_of_pos hH]

end Construction

end
