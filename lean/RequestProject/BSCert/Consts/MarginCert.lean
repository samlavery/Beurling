/-- Fixed-point upper bound for `1/(k+1)`. -/
def harmTermK (k : ℕ) : ℤ := FX.cdiv FX.ZI ((k + 1 : ℕ) : ℤ)

/-- `2^128 H_10000` rounded up, from the kernel-checked running sum. -/
def harmHiK : ℤ := FiniteN.K.sumUp harmTermK 10000 0 0

lemma harmonic_le_harmHiK : ((harmonic 10000 : ℚ) : ℝ) ≤ FX.toR harmHiK := by
  have h := FiniteN.K.sumUp_spec harmTermK (fun k => 1 / ((k : ℝ) + 1)) (fun k => by
    have := FiniteN.K.toR_cdivN_ge FX.ZI (d := k + 1) (by omega)
    rw [FX.toR_ZI] at this
    unfold harmTermK; push_cast at this ⊢; exact this) 10000 0 0
  rw [FX.toR_zero, zero_add, zero_add, ← Finset.range_eq_Ico] at h
  unfold harmonic harmHiK
  push_cast
  simpa [one_div] using h

/-- Upper bound for `I₃` from upper bounds for `γ ≤ H_n - log n`, `Ein(2)` and the integral. -/
