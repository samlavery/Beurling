  calc 2 * Real.exp Real.eulerMascheroniConstant * Real.exp (Ein 2) * ∫ v in Ioi (4 : ℝ), f3 v
      ≤ 2 * (eg.2 : ℝ) * (ee.2 : ℝ) * (j : ℝ) := by
        apply mul_le_mul _ hJ hJ0 (by positivity)
        apply mul_le_mul _ hEin he2.le (by positivity)
        linarith
    _ ≤ 6.7 := by norm_num at hB2' ⊢; linarith

/-! ## m5 and m6 -/

/-- **m5.** `(2.02/log 2)(I₁ + I₂ + I₃) ≤ 690` (value `688.88`). -/
theorem margin_total_le : 2.02 / Real.log 2 * (I1 + I2 + I3) ≤ 690 := by
  have h1 := I1_le
  have h2 := I2_le.2
  have h3 := I3_le.2
  have hl := Real.log_two_gt_d9
  have hl0 : 0 < Real.log 2 := by linarith
  have hI1 : 0 ≤ I1 := by rw [I1_eq]; positivity
  rw [div_mul_eq_mul_div, div_le_iff₀ hl0]
  norm_num at hl ⊢
  nlinarith

/-- **m6.** `690/Λ ≤ 7·10⁻⁶` for every `Λ ≥ 10⁸`. -/
theorem m6 {Λ : ℝ} (hΛ : 10 ^ 8 ≤ Λ) : 690 / Λ ≤ 7e-6 := by
  rw [div_le_iff₀ (by linarith)]
  norm_num at hΛ ⊢
  linarith

end BSCert.Consts
