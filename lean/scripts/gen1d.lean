import RequestProject.BSCert.AuxK
open BSCert BSCert.FX

/-- passing leaves of the bisection tree -/
partial def leaves (f : ℤ → ℤ → Bool) : ℕ → ℤ → ℤ → Option (List (ℤ × ℤ))
  | 0, a, b => if f a b then some [(a, b)] else none
  | d + 1, a, b => if f a b then some [(a, b)] else
      match leaves f d a ((a + b) / 2), leaves f d ((a + b) / 2) b with
      | some l1, some l2 => some (l1 ++ l2)
      | _, _ => none

def lit (z : ℤ) : String := if z < 0 then s!"({z})" else toString z

/-- cover `[a, b]` with top-level cells of ratio `num/den` (at least `minw`), depth `d` -/
partial def topCells (a b minw : ℤ) (num den : ℤ) (acc : Array (ℤ × ℤ)) : Array (ℤ × ℤ) :=
  if a ≥ b then acc else
  let y := max (a * num / den) (a + minw)
  if b ≤ y then acc.push (a, b) else topCells y b minw num den (acc.push (a, y))

def run (name cell : String) (f : ℤ → ℤ → Bool) (a b minw num den : ℤ) (d segmax : ℕ) :
    IO (String × String) := do
  let tops := topCells a b minw num den #[]
  let mut lv : Array (ℤ × ℤ) := #[]
  for c in tops do
    match leaves f d c.1 c.2 with
    | some l => lv := lv ++ l.toArray
    | none => throw (IO.userError s!"{name}: fail at {c.1}")
  let segs := (Array.range ((lv.size + segmax - 1) / segmax)).map fun k =>
    lv.extract (k * segmax) ((k + 1) * segmax)
  let mut src := ""
  let mut g := ""
  let mut i := 0
  for sg in segs do
    let X := if i = 0 then lit a else lit sg[0]!.1
    let Y := if i + 1 = segs.size then lit b else lit sg.back!.2
    let mids := String.intercalate ", " ((sg.toList.drop 1).map fun c => lit c.1)
    src := src ++ s!"lemma {name}_{i} : coverL {cell} {X} [{mids}] {Y} = true := by decide +kernel\n\n"
    g := if i = 0 then s!"(S {name}_{i})" else s!"(glueF {g} (S {name}_{i}))"
    i := i + 1
  IO.eprintln s!"{name}: {tops.size} top cells, {lv.size} leaves, {segs.size} declarations"
  return (src, g)

def run2 (name cell sound pred : String) (f : ℤ → ℤ → Bool) (a b : ℕ) (num den : ℤ) (d segmax : ℕ) :
    IO String := do
  let A : ℤ := (a : ℤ) * ZI
  let B : ℤ := (b : ℤ) * ZI
  let tops := topCells A B 0 num den #[]
  let mut lv : Array (ℤ × ℤ) := #[]
  for c in tops do
    match leaves f d c.1 c.2 with
    | some l => lv := lv ++ l.toArray
    | none => throw (IO.userError s!"{name}: fail at {c.1}")
  let segs := (Array.range ((lv.size + segmax - 1) / segmax)).map fun k =>
    lv.extract (k * segmax) ((k + 1) * segmax)
  let mut src := ""
  let mut g := ""
  let mut i := 0
  for sg in segs do
    let X := if i = 0 then s!"({a} * ZI)" else lit sg[0]!.1
    let Y := if i + 1 = segs.size then s!"({b} * ZI)" else lit sg.back!.2
    let mids := String.intercalate ", " ((sg.toList.drop 1).map fun c => lit c.1)
    src := src ++ s!"lemma {name}_{i} : coverL {cell} {X}\n    [{mids}] {Y} = true := by decide +kernel\n\n"
    let S := s!"(coverL_sound {pred} _ {sound} _ _ _ {name}_{i})"
    g := if i = 0 then S else s!"(glueF {g}\n    {S})"
    i := i + 1
  IO.eprintln s!"{name}: {tops.size} top cells, {lv.size} leaves, {segs.size} declarations"
  return src ++ s!"theorem {name}_range \{r : ℝ → ℝ} (hr : DickmanRatioFacts r) :\n    ∀ u : ℝ, toR ({a} * ZI) ≤ u → u ≤ toR ({b} * ZI) → {pred} u :=\n  {g}\n\n"

def main : IO Unit := do
  let mut src := "module\n\npublic import RequestProject.BSCert.AuxK\n\n/-! Kernel-checked covers for the three checks of `aux_cert_arb.py` (explicit break points,\nthe accepted leaves of an adaptive bisection). Generated by `gen1d.lean`. -/\n\n@[expose] public section\n\nnamespace BSCert\n\nopen FX\n\n"
  src := src ++ (← run2 "cAK" "(fun a b => cACellF a b)" "(cACellF_sound hr)" "(fun u => 0 < cAMargin r u)" cACellF 27 400000 21 20 8 30)
  src := src ++ (← run2 "lemVK" "(fun a b => lemVCellF a b)" "(lemVCellF_sound hr)" "(fun u => 0 < lemVLHS r u)" lemVCellF 1 1000000 21 20 8 30)
  src := src ++ (← run2 "lemVExtK" "(fun a b => lemVExtCellF a b)" "(lemVExtCellF_sound hr)" "(fun u => 0 < lemVExtLHS r u)" lemVExtCellF 1 2 101 100 8 30)
  src := src ++ "end BSCert\n"
  IO.FS.writeFile "RequestProject/BSCert/AuxKCovers.lean" src
