import RequestProject.BSCert.Z2K
open BSCert BSCert.FX BSCert.Z2 BSCert.Ex

partial def bisC (f : ℤ → ℤ → Bool) : ℕ → ℤ → ℤ → Bool × ℕ
  | 0, a, b => (f a b, 1)
  | d + 1, a, b => if f a b then (true, 1) else
      let p := bisC f d a ((a + b) / 2)
      if p.1 then let q := bisC f d ((a + b) / 2) b; (q.1, 1 + p.2 + q.2) else (false, 1 + p.2)

/-- passing leaves of the bisection tree -/
partial def leaves (f : ℤ → ℤ → Bool) : ℕ → ℤ → ℤ → Option (List (ℤ × ℤ))
  | 0, a, b => if f a b then some [(a, b)] else none
  | d + 1, a, b => if f a b then some [(a, b)] else
      match leaves f d a ((a + b) / 2), leaves f d ((a + b) / 2) b with
      | some l1, some l2 => some (l1 ++ l2)
      | _, _ => none

/-- top-level cells: list of (x, y, evals) -/
partial def cellsOf (f : ℤ → ℤ → Bool) (step : ℤ → ℤ) (x b : ℤ) (acc : Array (ℤ × ℤ × ℕ)) :
    Except String (Array (ℤ × ℤ × ℕ)) :=
  let y := step x
  if b ≤ y then
    let p := bisC f 5 x b
    if p.1 then .ok (acc.push (x, b, p.2)) else .error s!"fail at {x}"
  else
    if x < y then
      let p := bisC f 5 x y
      if p.1 then cellsOf f step y b (acc.push (x, y, p.2)) else .error s!"fail at {x}"
    else .error "no progress"

/-- group cells into segments of ≤ 25 evaluations: (x, y, ncells, evals) -/
def SEGMAX : ℕ := 12

def segs (cs : Array (ℤ × ℤ × ℕ)) : Array (ℤ × ℤ × ℕ × ℕ) := Id.run do
  let mut out : Array (ℤ × ℤ × ℕ × ℕ) := #[]
  let mut sx : ℤ := 0
  let mut k : ℕ := 0
  let mut e : ℕ := 0
  let mut started := false
  for c in cs do
    if !started then sx := c.1; started := true
    if k > 0 && e + c.2.2 > SEGMAX then
      out := out.push (sx, c.1, k, e)
      sx := c.1; k := 0; e := 0
    k := k + 1; e := e + c.2.2
  if k > 0 then out := out.push (sx, cs.back!.2.1, k, e)
  return out

def lit (z : ℤ) : String := if z < 0 then s!"({z})" else toString z

def main (args : List String) : IO Unit := do
  let idx := args[0]!
  let a : ℕ := args[1]!.toNat!
  let b : ℕ := args[2]!.toNat!
  let ns := s!"K{idx}"
  let mut src := ""
  let mut bands : Array String := #[]
  let mut imports : Array String := #[]
  let mut l := a
  let mut bi := 0
  let mut total := 0
  let mut ndecl := 0
  while l < b do
    let l2 := min b (l * 11 / 10)
    let la : ℤ := (l : ℤ) * ZI
    let lb : ℤ := (l2 : ℤ) * ZI
    match bandDataF la lb, feval u0Ex [⟨la, lb⟩] with
    | some (s, va, vb), some U0 =>
      let n : ℤ := max 8 ((vb - va) / max ZI (U0.lo / 100))
      let H : ℤ := 32 * ((vb - va) / n + 1)
      let cu ← match cellsOf (fun x y => cellUF la lb x y) stepUF (2 * ZI) s #[] with
        | .ok c => pure c | .error e => throw (IO.userError s!"band {l}: u {e}")
      let cv ← match cellsOf (fun x y => cellVF la lb x y) (fun x => x + H) va vb #[] with
        | .ok c => pure c | .error e => throw (IO.userError s!"band {l}: v {e}")
      let mut lu : Array (ℤ × ℤ) := #[]
      for c in cu do
        match leaves (fun x y => cellUF la lb x y) 5 c.1 c.2.1 with
        | some ll => lu := lu ++ ll.toArray
        | none => throw (IO.userError "leaf fail u")
      let mut lv : Array (ℤ × ℤ) := #[]
      for c in cv do
        match leaves (fun x y => cellVF la lb x y) 5 c.1 c.2.1 with
        | some ll => lv := lv ++ ll.toArray
        | none => throw (IO.userError "leaf fail v")
      let su := (Array.range ((lu.size + SEGMAX - 1) / SEGMAX)).map fun k =>
        lu.extract (k * SEGMAX) ((k + 1) * SEGMAX)
      let sv := (Array.range ((lv.size + SEGMAX - 1) / SEGMAX)).map fun k =>
        lv.extract (k * SEGMAX) ((k + 1) * SEGMAX)
      let mut bsrc := s!"module\n\npublic import RequestProject.BSCert.Z2K\n\n/-! Region Z2, kernel-checked: piece {idx}, band {bi}, `ℓ ∈ [{l}, {l2}]`. Generated by\n`genz2.lean`. -/\n\n@[expose] public section\n\nnamespace BSCert.Z2.{ns}\n\nopen FX\n\n"
      let LA := s!"({l} * ZI)"
      let LB := s!"({l2} * ZI)"
      bsrc := bsrc ++ s!"lemma bd{bi} : bandDataF {LA} {LB} = some ({lit s}, {lit va}, {lit vb}) := by\n  decide +kernel\n\n"
      let mut i := 0
      let mut gu := ""
      for sg in su do
        let X := if i = 0 then "(2 * ZI)" else lit sg[0]!.1
        let mids := String.intercalate ", " ((sg.toList.drop 1).map fun c => lit c.1)
        bsrc := bsrc ++ s!"lemma u{bi}_{i} : coverL (fun a b => cellUF {LA} {LB} a b)\n    {X} [{mids}] {lit sg.back!.2} = true := by decide +kernel\n\n"
        gu := if i = 0 then s!"(segLU hr u{bi}_{i})" else s!"(glueI {gu} (segLU hr u{bi}_{i}))"
        total := total + sg.size; ndecl := ndecl + 1
        i := i + 1
      let mut j := 0
      let mut gv := ""
      for sg in sv do
        let mids := String.intercalate ", " ((sg.toList.drop 1).map fun c => lit c.1)
        bsrc := bsrc ++ s!"lemma v{bi}_{j} : coverL (fun a b => cellVF {LA} {LB} a b)\n    {lit sg[0]!.1} [{mids}] {lit sg.back!.2} = true := by decide +kernel\n\n"
        gv := if j = 0 then s!"(segLV hr v{bi}_{j})" else s!"(glueI {gv} (segLV hr v{bi}_{j}))"
        total := total + sg.size; ndecl := ndecl + 1
        j := j + 1
      bsrc := bsrc ++ s!"theorem band{bi} \{r : ℝ → ℝ} (hr : DickmanRatioFacts r) :\n    ∀ ℓ : ℝ, toR {LA} ≤ ℓ → ℓ ≤ toR {LB} → Z2Prop r ℓ :=\n  bandF bd{bi} {gu}\n    {gv}\n\n"
      bsrc := bsrc ++ s!"end BSCert.Z2.{ns}\n"
      IO.FS.writeFile s!"RequestProject/BSCert/Z2KChunks/K{idx}B{bi}.lean" bsrc
      imports := imports.push s!"public import RequestProject.BSCert.Z2KChunks.K{idx}B{bi}"
      bands := bands.push s!"(band{bi} hr)"
      IO.eprintln s!"band {bi} [{l},{l2}] u-cells {cu.size} v-cells {cv.size} segs {su.size}+{sv.size} leaves {lu.size}+{lv.size}"
    | _, _ => throw (IO.userError s!"band {l}: no data")
    l := l2
    bi := bi + 1
  let mut g := bands[0]!
  for k in [1:bands.size] do g := s!"(glueI {g} {bands[k]!})"
  src := s!"module\n\n{String.intercalate "\n" imports.toList}\n\n/-! Region Z2, kernel-checked piece {idx}: `ℓ ∈ [{a}, {b}]`, glued from {bi} bands of ratio `1.1`\n(one file per band, `K{idx}B*.lean`; adaptive covers, at most {SEGMAX} cell evaluations per\ndeclaration). Generated by `genz2.lean`. -/\n\n@[expose] public section\n\nnamespace BSCert.Z2.{ns}\n\nopen FX\n\n" ++ s!"/-- **Region Z2, piece {idx}**, kernel-checked: `Z2Prop r ℓ` for `ℓ ∈ [{a}, {b}]`. -/\ntheorem chunk{idx}K \{r : ℝ → ℝ} (hr : DickmanRatioFacts r) :\n    ∀ ℓ : ℝ, ({a} : ℝ) ≤ ℓ → ℓ ≤ ({b} : ℝ) → Z2Prop r ℓ := by\n  have h := range_intZ (a := {a}) (b := {b}) {g}\n  intro ℓ h1 h2\n  exact h ℓ (by exact_mod_cast h1) (by exact_mod_cast h2)\n\nend BSCert.Z2.{ns}\n"
  IO.FS.writeFile s!"RequestProject/BSCert/Z2KChunks/K{idx}.lean" src
  IO.println s!"K{idx}: {bi} bands, {ndecl} cover declarations, {total} cell evaluations"
